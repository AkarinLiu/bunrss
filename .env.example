DATABASE_URL=./data/bunrss.db
PORT=3000
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# SMTP (optional). Setting SMTP_HOST turns on email sending *and* forces new public sign-ups to
# verify their email before they can log in. Existing accounts are treated as already verified.
# APP_URL is the public base URL used in verification links when there is no browser Origin
# header (e.g. behind a reverse proxy); requests from the browser fall back to their own Origin.
# APP_URL=https://rss.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS (port 465); 587/25 use STARTTLS automatically
# Never put SMTP_SECURE=true on 587/25: TLS on a plaintext port fails with WRONG_VERSION_NUMBER.
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=bunrss <noreply@example.com>
# SMTP_DKIM_SELECTOR=       # check:mail verifies this selector; copy the record name from the mail
#                           # console (企业邮 uses random ones like yfrh2602, not "default")
