{
  "name": "bunrss",
  "module": "server/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "bun x vite --config web/vite.config.ts",
    "build": "bun x vite build --config web/vite.config.ts",
    "start": "bun server/index.ts",
    "migrate": "bun run server/migrate.ts",
    "smoke": "bun run server/smoke.ts",
    "check": "bun run server/core.check.ts",
    "check:greader": "bun run server/greader.check.ts",
    "e2e": "bun run build && bun run e2e.setup.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "playwright": "^1.63.0",
    "vite": "^8.3.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "pinia": "^4.0.3",
    "rss-parser": "^3.13.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
